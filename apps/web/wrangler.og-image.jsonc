{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "artifactshare-og-image-public-preview",
  "compatibility_date": "2026-06-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/og-image.ts",
  "rules": [{ "type": "Data", "globs": ["**/*.woff2"], "fallthrough": true }],
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "SLACK_PREVIEW_FONT_KV",
      "id": "00000000000000000000000000000000",
    },
  ],
  "vars": { "APP_ENV": "development", "DEFAULT_LOCALE": "en" },
  "env": {
    "production": {
      "name": "artifactshare-og-image",
      "preview_urls": false,
      "kv_namespaces": [
        {
          "binding": "SLACK_PREVIEW_FONT_KV",
          "id": "dfc62ed547734ecfa3f63d1f0850bbb0",
        },
      ],
      "vars": { "APP_ENV": "production", "DEFAULT_LOCALE": "en" },
    },
  },
}
