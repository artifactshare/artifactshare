{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "artifactshare-public-preview",
  "compatibility_date": "2026-06-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "tail_consumers": [{ "service": "artifactshare-alerts-public-preview" }],
  "workflows": [
    {
      "name": "artifactshare-public-d1-backup",
      "binding": "D1_BACKUP_WORKFLOW",
      "class_name": "D1BackupWorkflow",
    },
    {
      "name": "artifactshare-public-link-abuse-judgment",
      "binding": "LINK_ABUSE_JUDGMENT_WORKFLOW",
      "class_name": "LinkAbuseJudgmentWorkflow",
    },
  ],
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artifactshare-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations",
    },
  ],
  "kv_namespaces": [
    { "binding": "VIEW_DEDUP", "id": "00000000000000000000000000000000" },
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "artifactshare-local-artifacts" },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "artifactshare-local-backups",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ARTIFACT_LIVE", "class_name": "ArtifactLiveRoom" }],
  },
  "services": [
    {
      "binding": "OG_IMAGE_WORKER",
      "service": "artifactshare-og-image-public-preview",
    },
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArtifactLiveRoom"] }],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    {
      "name": "MCP_RATELIMIT_USER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "MCP_RATELIMIT_WORKSPACE",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "VIEWER_RATELIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "RECIPIENT_SUGGESTIONS_RATELIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "vars": {
    "APP_ENV": "development",
    "DEFAULT_LOCALE": "en",
    "LINK_LOW_TRUST_ACCOUNT_AGE_DAYS": "14",
    "LINK_LOW_TRUST_LINK_PUBLISH_COUNT": "5",
    "LINK_NEW_ACCOUNT_LINK_PUBLISH_DAILY_LIMIT": "20",
    "BETTER_AUTH_URL": "https://localhost:5173",
    "D1_BACKUP_ACCOUNT_ID": "public-local-account",
    "D1_BACKUP_DATABASE_ID": "public-local-database",
    "STRIPE_PRICE_PLUS_MONTHLY": "price_public_local_plus_monthly",
    "STRIPE_PRICE_PLUS_YEARLY": "price_public_local_plus_yearly",
    "STRIPE_PRICE_TEAM_MONTHLY": "price_public_local_team_monthly",
    "STRIPE_PRICE_TEAM_YEARLY": "price_public_local_team_yearly",
    "STRIPE_PRODUCT_STORAGE_OVERAGE": "product_public_local_storage_overage",
    "STRIPE_PORTAL_CONFIGURATION": "bpc_public_local",
    "GA4_MEASUREMENT_ID": "G-TEST",
    "LINK_ABUSE_SPIKE_WINDOW_MINUTES": "60",
    "LINK_ABUSE_SPIKE_THRESHOLD": "200",
    "LINK_ABUSE_JUDGMENT_COOLDOWN_MINUTES": "360",
    "LINK_ABUSE_MANUAL_COOLDOWN_MINUTES": "5",
    "LINK_ABUSE_JUDGMENT_PROVIDER": "workers-ai",
  },
}
