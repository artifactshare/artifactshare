{
  "$schema": "https://oxc.rs/schema/oxlintrc.json",
  "jsPlugins": [
    "./scripts/copy-glossary-lint-plugin.mjs",
    "./scripts/analytics-lint-plugin.mjs",
    "./scripts/module-boundary-lint-plugin.mjs"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-redeclare": "off",
    "no-unused-vars": "off",
    "require-await": "error",
    "no-shadow": "error",
    "unicorn/prefer-string-starts-ends-with": "off",
    "unicorn/no-useless-length-check": "off",
    "copy-glossary/no-violations": "error",
    "analytics/typed-sender": "error",
    "module-boundary/no-internal-imports": "warn"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/__tests__/**"
      ],
      "rules": {
        "require-await": "off"
      }
    }
  ],
  "ignorePatterns": [
    ".turbo/**",
    "**/node_modules/**",
    "build/**",
    "apps/web/build/**",
    "tools/static-site-fixtures/builders/**",
    "tools/static-site-fixtures/static-sites/**",
    "fixtures/static-sites/**",
    ".react-router/**",
    "apps/web/.react-router/**",
    ".wrangler/**",
    "worker-configuration.d.ts",
    "apps/web/worker-configuration.d.ts"
  ]
}
