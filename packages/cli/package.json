{
  "name": "@artifactshare/cli",
  "version": "0.13.3",
  "description": "Upload and share HTML, Markdown, folders, and static sites from terminals, AI agents, automation, and CI.",
  "homepage": "https://artifactshare.com/connect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artifactshare/artifactshare.git",
    "directory": "packages/cli"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "artifact-share",
    "cli",
    "upload",
    "share",
    "static-site",
    "automation",
    "ai-agents"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "cli": "./dist/index.js",
    "artifactshare": "./dist/index.js",
    "artifactshare-preview-cursor": "./dist/cursor-acp-entry.js"
  },
  "scripts": {
    "build": "node scripts/generate-preview-messages.mjs && tsdown",
    "prepack": "pnpm run build",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "generate:preview-messages": "node scripts/generate-preview-messages.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "gunshi": "0.37.2",
    "undici": "8.10.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@artifactshare/viewer-kit": "workspace:*",
    "@types/node": "22.20.2",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
