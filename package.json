{
  "name": "artifactshare",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "check:public-development-guard": "node scripts/public-development-guard.mjs --check",
    "review:codex": "node scripts/codex-review.mjs",
    "review:claude": "node scripts/claude-review.mjs",
    "review:implementation": "node scripts/implementation-review-gate.mjs",
    "review:cursor": "node scripts/cursor-review.mjs",
    "review:spec": "node scripts/spec-review-gate.mjs",
    "pr:publish": "node scripts/pr-publish.mjs",
    "pr:ready": "node scripts/pr-ready.mjs",
    "pr:landed": "node scripts/pr-landed.mjs",
    "pr:queue": "node scripts/pr-queue.mjs",
    "prepare": "node scripts/public-hook-setup.mjs",
    "check:public-hook": "node scripts/public-hook-setup.mjs --check",
    "public:scan": "node scripts/public-repository-scan.mjs",
    "link-abuse:eval": "node scripts/link-abuse-eval.mjs",
    "fixtures:build": "pnpm --filter @artifactshare/static-site-fixtures build:fixtures",
    "link-open:metrics": "node scripts/link-open-metrics.mjs",
    "db:apply:local": "pnpm --filter @artifactshare/web db:apply:local",
    "dev": "pnpm --filter @artifactshare/web dev",
    "dev:setup": "node scripts/public-hook-setup.mjs && node scripts/dev-setup.mjs",
    "check:dev-setup": "node scripts/check-dev-setup.mjs",
    "check:in-app-navigation": "node scripts/in-app-navigation.mjs",
    "check:scenario-routes": "node scripts/scenario-route-integration.mjs",
    "screens:capture": "node scripts/run-screen-capture.mjs",
    "walkthroughs:capture": "node scripts/run-task-walkthroughs.mjs",
    "critique:tasks": "node scripts/task-critique.mjs",
    "billing:regression": "node scripts/billing-regression.mjs",
    "audit:ai-search": "node scripts/audit-ai-search-eligibility.mjs",
    "measure:cli-tests": "node scripts/measure-cli-tests.mjs",
    "perf:trace": "node scripts/perf-trace.mjs",
    "format": "vp fmt -c .oxfmtrc.json --check",
    "verify": "node scripts/verify.mjs",
    "lint": "vp lint -c .oxlintrc.json",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "report:spacing-ownership": "node scripts/check-design-tokens.mjs --spacing-report",
    "audit:tests": "node scripts/public-test-audit.mjs",
    "check:screen-ledger": "node scripts/check-screen-ledger.mjs",
    "check:task-ledger": "node scripts/check-task-ledger.mjs",
    "check:task-walkthroughs": "node scripts/check-task-walkthroughs.mjs",
    "check:migrations": "pnpm --filter @artifactshare/web check:migrations",
    "check:schema": "pnpm --filter @artifactshare/web check:schema",
    "check:d1-compatibility": "node scripts/check-d1-compatibility.mjs",
    "generate:contract-surfaces": "pnpm --filter @artifactshare/contract generate",
    "check:contract-surfaces": "pnpm --filter @artifactshare/contract check:surfaces",
    "check:cli-changelog": "node scripts/check-cli-changelog.mjs",
    "check:cli-release": "node scripts/check-cli-changelog.mjs --release",
    "check:npm-reserved": "node scripts/check-npm-reserved-package.mjs",
    "typecheck": "pnpm --filter @artifactshare/web typecheck && pnpm typecheck:task-ledger && pnpm --filter @artifactshare/contract typecheck && pnpm --filter @artifactshare/cli typecheck && pnpm --filter @artifactshare/qm-bridge typecheck",
    "typecheck:task-ledger": "node scripts/generate-task-ledger-types.mjs --check && pnpm --filter @artifactshare/web exec tsc -p ../../scripts/tsconfig.json",
    "test:scripts": "node --test scripts/*.test.mjs packages/contract/generate-surfaces.test.mjs",
    "test": "pnpm fixtures:build && pnpm test:scripts && pnpm --filter @artifactshare/web test && pnpm --filter @artifactshare/contract test && pnpm --filter @artifactshare/cli test && pnpm --filter @artifactshare/qm-bridge test",
    "test:nonvisual": "pnpm test:unit && pnpm test:behavior-browser",
    "test:unit": "pnpm test:unit:noncli && pnpm --filter @artifactshare/cli test",
    "test:unit:noncli": "pnpm fixtures:build && pnpm test:scripts && pnpm --filter @artifactshare/web test:unit && pnpm --filter @artifactshare/contract test && pnpm --filter @artifactshare/qm-bridge test",
    "test:d1": "pnpm --filter @artifactshare/web test:d1",
    "test:behavior-browser": "pnpm --filter @artifactshare/web test:behavior-browser",
    "check:browser-local-state": "node scripts/browser-local-state.mjs",
    "build": "pnpm --filter @artifactshare/web build && pnpm --filter @artifactshare/contract build && pnpm --filter @artifactshare/cli build && pnpm --filter @artifactshare/qm-bridge build",
    "build:alerts": "pnpm --filter @artifactshare/web build:alerts",
    "build:og-image": "pnpm --filter @artifactshare/web build:og-image",
    "integration:test:run": "pnpm --filter @artifactshare/web integration:test:run",
    "check:cli-reference": "pnpm --filter @artifactshare/contract check:surfaces",
    "build:sandbox": "pnpm --filter @artifactshare/web build:sandbox",
    "check:doctor": "pnpm exec react-doctor . --json -y | node scripts/check-doctor.mjs",
    "validate": "pnpm validate:nonvisual && pnpm visual:compose",
    "validate:nonvisual": "pnpm validate:static && pnpm validate:cli && pnpm test:behavior-browser && pnpm validate:build",
    "validate:static": "pnpm format && pnpm lint && pnpm check:public-development-guard && pnpm check:public-hook && pnpm check:design-tokens && pnpm audit:tests && pnpm check:screen-ledger && pnpm check:task-ledger && pnpm check:task-walkthroughs && pnpm check:migrations && pnpm check:schema && pnpm check:d1-compatibility && pnpm test:d1 && pnpm check:contract-surfaces && pnpm check:cli-release && pnpm check:npm-reserved && pnpm typecheck && pnpm test:unit:noncli && pnpm check:doctor && pnpm public:scan .",
    "validate:cli": "pnpm --filter @artifactshare/cli test && pnpm check:cli-reference && pnpm --filter @artifactshare/cli test:package",
    "validate:build": "pnpm build && pnpm build:alerts && pnpm build:og-image && pnpm integration:test:run && pnpm build:sandbox && pnpm test:runtime",
    "test:runtime": "node scripts/public-runtime-smoke.mjs",
    "visual:compose": "docker compose -f compose.playwright.yml run --rm visual",
    "visual:compose:update": "docker compose -f compose.playwright.yml run --rm visual-update",
    "visual:fault-injection": "node scripts/verify-visual-fault-injection.mjs",
    "task:scope": "node scripts/task-scope.mjs"
  },
  "devDependencies": {
    "@tanstack/markdown": "0.0.14",
    "oxc-parser": "0.149.0",
    "react-doctor": "0.9.12",
    "vite-plus": "0.3.1",
    "wrangler": "4.131.1",
    "yaml": "2.9.1"
  }
}
